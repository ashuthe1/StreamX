# API reverse proxy (round robin between Asia and Europe backends)
:3000 {
    handle /api/* {
        reverse_proxy {
            to http://app-asia:3000 http://app-europe:3000
            lb_policy round_robin
            health_uri /api/health
        }
    }
}

# WebSocket reverse proxy (round robin)
:3001 {
    handle /* {
        reverse_proxy {
            to http://app-asia:3001 http://app-europe:3001
            lb_policy round_robin
            health_uri /api/health
        }
    }
}
